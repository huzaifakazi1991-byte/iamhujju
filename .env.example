# Create a Neon database and set its PostgreSQL connection URL here.
# Keep this value on the API server only; never use a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Use a random secret of at least 32 bytes. Keep it stable and backed up;
# changing it makes saved provider API keys undecryptable.
API_KEY_ENCRYPTION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Set only for a one-time migration if old keys were encrypted with a different
# secret. Never set this to FREELLMAPI_KEY automatically.
# LEGACY_API_KEY_ENCRYPTION_SECRET=

FREELLMAPI_BASE_URL=https://your-provider.example/v1
FREELLMAPI_KEY=your_freellmapi_key
# Shared server-key chat access is disabled unless explicitly enabled.
# ALLOW_SHARED_FREELLMAPI_KEY=true
# APP_ORIGIN=https://iamhujju.com


