# Create a Neon database and set its PostgreSQL connection URL here.
# Keep this value on the API server only; never use a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Use a random secret of at least 32 bytes. Keep it stable and backed up;
# changing it makes saved provider API keys undecryptable.
API_KEY_ENCRYPTION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Set only for a one-time migration if old keys were encrypted with a different
# secret. Never set this to FREELLMAPI_KEY automatically.
# LEGACY_API_KEY_ENCRYPTION_SECRET=

FREELLMAPI_BASE_URL=https://your-provider.example/v1
FREELLMAPI_KEY=your_freellmapi_key
# Shared server-key chat access is disabled unless explicitly enabled.
# ALLOW_SHARED_FREELLMAPI_KEY=true
# APP_ORIGIN=https://iamhujju.com


# Firebase Client Configuration for iamhujju
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=iamhujju-680e8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iamhujju-680e8
VITE_FIREBASE_STORAGE_BUCKET=iamhujju-680e8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1071730198353
VITE_FIREBASE_APP_ID=1:1071730198353:web:298b63b8db74152828f570
VITE_FIREBASE_MEASUREMENT_ID=G-69KG8HMRSH

# Razorpay & Payment Gateway Configuration
# Currency: INR (₹) - Loaded strictly on server-side (never in client bundles)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
OFFICIAL_UPI_ID=
RAZORPAY_ACCOUNT_NAME=iamhujju

# Frontend framework prefix (KEY_ID only, never KEY_SECRET)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Required from the Phase 1/2 security fixes (PRs #44/#45) — set these BEFORE
# deploying, or the corresponding features change behavior:

# Admin/owner gate: comma-separated, trimmed, lowercased emails granted
# owner_unlimited + /api/admin access. Previously hardcoded in server.js.
# If this is empty, NO account gets admin privileges.
# ADMIN_EMAILS=owner@example.com,admin2@example.com

# Owner master API key (sk-hujju-...). MUST be a freshly generated value:
# the previous hardcoded key was leaked in git history and must be rotated.
# OWNER_MASTER_KEY=sk-hujju-generate-a-new-random-512bit-hex-or-longer

# Server host binding. Defaults: 127.0.0.1 in local dev, 0.0.0.0 only when
# NODE_ENV=production. Cloud deployments without NODE_ENV set MUST set HOST,
# otherwise the API binds loopback and is unreachable from outside.
# HOST=0.0.0.0

# Image generation fallback. The old silent pollinations.ai fallback is now
# opt-in. Enable to preserve pre-fix behavior when no ElectronHub/OpenRouter
# key is configured; otherwise image generation fails closed with 502.
# ALLOW_POLLINATIONS_FALLBACK=true

# Optional provider keys (pool registration is live: ELECTRONHUB, OPENROUTER,
# COHERE serve chat models; COHERE now routes via the OpenAI-compatible API).
# ELECTRONHUB_API_KEYS=
# OPENROUTER_API_KEYS=
# COHERE_API_KEYS=
