{
  "name": "iam_hujju_",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server.js",
    "dev:web": "vite",
    "start": "node server.js",
    "start:api": "node server.js",
    "start:prod": "npm run build && node server.js",
    "deploy": "npm run build && git push origin main",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test server.test.js aiGateway.test.js database.test.js database.integration.test.js googleGemini.test.js huzaifaOmni.test.js safeMarkdown.test.js src/modelCatalog.test.js src/chatStorage.test.js src/skillsCatalog.test.js",
    "test:database": "node --test database.integration.test.js",
    "db:seed": "node -e \"console.log('[db:seed] No manual seed required — the server boot migration (migrateDatabase + bootstrapOwnerAccount) creates the schema and seeds the owner account automatically at startup.')\"",
    "migrate:neon": "node scripts/migrate-local-to-neon.js",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase": "^13.4.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "pg-mem": "^3.0.14",
    "prisma": "^6.19.3",
    "vite": "^8.3.6"
  }
}
