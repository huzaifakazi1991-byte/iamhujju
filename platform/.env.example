# Database (Neon / Render Postgres / any PostgreSQL)
DATABASE_URL="postgresql://user:pass@host:5432/db"

# Auth
JWT_SECRET="generate with: openssl rand -hex 32"
APP_URL="http://localhost:3000"

# Seed admin (used by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-immediately"

# Provider keys are added at runtime via the admin panel (encrypted at rest).
# Optional: only needed to provision encryption before first boot.
KEY_ENCRYPTION_SECRET="generate with: openssl rand -hex 32"

# Redis (optional; in-memory limiter fallback when unset)
REDIS_URL=""

# Stripe (optional; mock checkout when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google OAuth (optional; button hidden when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (optional; dev mode auto-verifies + surfaces links to admin)
SMTP_URL=""
